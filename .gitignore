# =====================================================================
#  MSA EcoSync - .gitignore
#
#  THIS FILE MUST EXIST BEFORE THE FIRST `git add`.
#  Git history is permanent. A secret committed once and deleted later
#  is still in the history, still clonable, and still readable by anyone
#  you ever give access to the repository.
# =====================================================================

# ---------- CREDENTIALS - never commit ----------
# These hold the live Starlink Wi-Fi password and the ArcGIS API token.
config.txt
config_new_keys_*.txt
*config*secret*
# Credentials for tools/spray_stats.py - ArcGIS username/password or API key.
tools/spray_stats_config.json
# Web map JSON backups written by spray_stats.py --setextent
tools/webmap_backup_*.json
ca.pem

# ---------- Arduino / arduino-cli build output ----------
# Hundreds of files, rewritten on every compile. Nothing here is source.
build/
build_out/
*.elf
*.bin
*.map
*.hex
*.partitions.bin
*.bootloader.bin

# ---------- The sketch subfolders are COPIES, not source ----------
# flash.bat copies the .ino into a folder of the same name so arduino-cli
# will accept it. Committing both means two copies that silently drift -
# which has already cost this project an evening once.
MSA_Weed_Tracker_prod_*/
MSA_Weed_Tracker_syncfix_*/

# ---------- Delivered copies, not source ----------
# Files downloaded from the assistant land here. They are SNAPSHOTS of things
# that already live in firmware/ or docs/, and committing them would put stale
# copies of the sketch beside the real one - the exact drift this file warns
# about above, and the thing that cost an evening once already.
Claude outputs/

# ---------- Logs ----------
build_log.txt
flash_log.txt
repair_log.txt
*.log

# ---------- Field data ----------
# Records pulled off the SD card. Keep them, but not in the code repo -
# they are operational data, they contain positions, and they grow.
pending.csv
pending_poly.csv
quarantine*.csv
*.gdb/
*.zip

# ---------- OS / editor noise ----------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
.vscode/
.idea/

# ---------- Added October 2026 ----------
# Build output for the RAWX test sketch, same reasoning as build_out/ above.
build_out*/

# Generated analysis output. Both scripts write into their own folders now;
# these are derived from the layer and can always be rebuilt.
tools/track_polygons/
tools/webmap_backup/
tools/webmap_backups/

# Redacted config. Safe to share by hand, but it still shows the SSID, the
# device id and the length of every secret, and it has no business in history.
tools/config_redacted.txt

# Remaining logs. The named ones above missed flash_rawx_log.txt,
# get_ca_pem_log.txt and end_of_day_log.txt.
*_log.txt

# Device data pulled off the SD card. Keep a dated COPY in docs/ when a file
# is evidence of something - bootlog.csv is cited in the README - but the live
# working copy is not source.
bootlog.csv
rejected.csv

# Editor and tool backups.
*.bak

# ---------- Added November 2026 ----------
# pending.csv and pending_poly.csv were named individually, which missed the
# track queue and - once LINE mode arrived - the line queue too. Match the
# family instead, so the next queue added is covered before it exists.
pending_*.csv

# Serial captures from monitor.bat. They are evidence while a fault is open and
# noise forever after, and a long session is megabytes.
tools/serial_logs/

# Stray serial dumps saved by hand into the repo root.
Trigger pin*.txt
